<ui:FluentWindow
    x:Class="DariaTech.PcDoctor.UI.Views.PinWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:DariaTech.PcDoctor.UI.ViewModels"
    xmlns:conv="clr-namespace:DariaTech.PcDoctor.UI.Converters"
    xmlns:models="clr-namespace:DariaTech.PcDoctor.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="{x:Static models:CompanyInfo.ProductFull}"
    Width="460" SizeToContent="Height"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    d:DataContext="{d:DesignInstance vm:PinViewModel}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{x:Static models:CompanyInfo.ProductFull}"
                     ShowMaximize="False" ShowMinimize="False" />

        <!-- Marken-Kopf -->
        <Border Grid.Row="1" Background="#0E3B34" Padding="24,20">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Assets/logo-mark.png" Width="34" Height="34"
                       Margin="0,0,14,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Headline}" Foreground="White"
                               FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="Zugang nur für autorisierte Techniker"
                               Foreground="#6FE0A8" FontSize="12" Margin="0,3,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Eingabe -->
        <StackPanel Grid.Row="2" Margin="24,20,24,20">
            <TextBlock Text="PIN eingeben" FontWeight="SemiBold" Margin="0,0,0,6" />

            <PasswordBox x:Name="PinBox" FontSize="18" Padding="10,8"
                         PasswordChanged="PinBox_PasswordChanged"
                         IsEnabled="{Binding IsInputEnabled}" />

            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,10,0,0"
                       FontSize="12.5" Foreground="#B3261E"
                       Visibility="{Binding Status, Converter={StaticResource NullToVis}}" />

            <ui:Button Content="Entsperren" Appearance="Primary" Margin="0,16,0,0"
                       Padding="18,9" HorizontalAlignment="Stretch"
                       Command="{Binding SubmitCommand}"
                       IsEnabled="{Binding IsInputEnabled}"
                       IsDefault="True" />

            <TextBlock Text="{Binding Footer}" FontSize="11" Opacity="0.6"
                       Margin="0,16,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
